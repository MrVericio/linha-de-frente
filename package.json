    "typecheck": "tsc --noEmit",
    "simtest": "node build.mjs && node dist/simtest.cjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.24.0",
    "puppeteer": "^24.43.1",
    "typescript": "^5.6.0"
  }
}
