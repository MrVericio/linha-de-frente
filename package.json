{
  "name": "linha-de-frente",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RTS de conquista territorial multiplayer no navegador (original, inspirado no genero .io de estrategia).",
  "scripts": {
    "build": "node build.mjs",
